class Random {
    field int value;

    constructor Random new() {
        let value = 1;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void seed(int s) {
        if (~(s = 0)) {
            let value = s;
        }
        return;
    }

    method int next() {
        // Lehmer LCG: multiplier=75, mod=32767 (Park-Miller)
        // Full period of 32766, excellent distribution for 16-bit
        let value = (value * 75) - ((value * 75 / 32767) * 32767);
        if (value < 0) { let value = -value; }
        if (value = 0) { let value = 1; }
        return value;
    }

    method int range(int seed, int a, int b) {
        var int raw;
        var int span;
        let value = value + seed;
        if (value < 0) { let value = -value; }
        if (value = 0) { let value = 1; }
        let raw = next();
        let span = (b - a) + 1;
        return a + (raw - ((raw / span) * span));
    }
}
