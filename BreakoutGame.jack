/**
 * Represents a Breakout game.
 */
class BreakoutGame {

    field Ball ball;            // ball
    field Paddle paddle;        // paddle
    field int paddleWidth;      // width of paddle
    field int paddleHeight;      // height of paddle
    field int paddleSpeed;       // speed of the paddle
    field Array bricks;          // bricks
    field int numXBricks;        // num hoirzontal bricks
    field int numYBricks;        // num vertical bricks
    field int brickWidth;       // brick batWidth
    field int brickHeight;      // brickHeight
    field int leftWall;         // left wall position
    field int rightWall;        // right wall position
    field int topWall;          // top wall position
    field int bottomWall;       // bottom wall position
    field int wall;             // current wall the ball is bouncing off
    field int lastWall;         // last wall the ball bounced from
    field int score;            // current game score

    field boolean exit;         // true when the game is over
    field boolean isKeyEsc;     // true if game is over because user pressed Esc

    field int seed;             // seed for random number generator
    field Random random;        // generate pseudo random values
    field int generateModifier; // flag to determine if a modifier should be generated
    field Modifier modifier;     // modifier
    field boolean switchKeys;    // true si los controles estan invertidos (type 3)
    field boolean piercing;      // true si la pelota es perforadora (type 6)

    // Bugfix abc935kf: Output.printString("  ") creates a temporary string "   " but its never freed
    field String twoSpaces;

    // Bugfix o646i349o6h: count at most 2 blocks of piercing
    field int piercingHits;

    // ---------- new feature that prints modifier on the screen -------
    field String modifierLabelClear;

    /* Constructs a new Breakout game. */
    constructor BreakoutGame new() {

        var int i, j;
        var Array rowBricks;

        do Screen.clearScreen();

        let paddleWidth = 40;  // initial paddle size
        let paddleHeight = 7;  // paddle height
        let paddleSpeed = 7;
        let paddle = Paddle.new(230, 248, paddleWidth, paddleHeight, paddleSpeed);

        let ball = Ball.new(253, 240);
        do ball.setDestination(400, 0);

        let random = Random.new();
        let modifier = Modifier.new(0, 0, 0); // initialize modifier
        do modifier.setOnScreen(false);
        let switchKeys = false;
        let piercing = false;

        let numXBricks = 6;
        let numYBricks = 5;
        let bricks = Array.new(numYBricks);
        let brickWidth = ((484 - (2 * numXBricks)) / numXBricks);
        let brickHeight = 60 / numYBricks;
        let i = 0;
        while ( i < numYBricks ) {
            let bricks[i] = Array.new(numXBricks);
            let rowBricks = bricks[i];
            let j = 0;
            while ( j < numXBricks ) {
                let rowBricks[j] = Brick.new(16 + ((brickWidth + 2) * j), 30 + ((brickHeight + 2) * i), brickWidth, brickHeight);
                let j = j + 1;
            }
            let i = i + 1;
        }

        do Screen.drawRectangle(0, 15, 511, 27);
        do Screen.drawRectangle(0, 28 , 12, 255);
        do Screen.drawRectangle(499, 28 , 511, 255);
        let leftWall = 13;
        let rightWall = 499 - ball.getSize() - 1;
        let topWall = 28;
        let bottomWall = 255 - paddleHeight - ball.getSize() - 1;
        let lastWall = 0;
        let score = 0;
        let exit = false;
        let isKeyEsc = false;

        do Output.moveCursor(0,0);
        do Output.printString("Score: 0");

        do Output.moveCursor(0,28);
        do Output.printString("BREAKOUT!");
        do Output.moveCursor(0,44);
        do Output.printString("Bricks remaining: ");
        do Output.printInt((numXBricks * numYBricks));

        // --------------- Bugfix abc935kf ---------------
        let twoSpaces = String.new(2);
        do twoSpaces.appendChar(32);
        do twoSpaces.appendChar(32);
        // ----------------------------------------

        // ---------------- Bugfix o646i349o6h -------------
        let piercingHits = 0;
        // -------------------------------------------------

        // pre-allocate clear string for modifier label (longest label is 12 chars)
        let modifierLabelClear = String.new(12);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);
        do modifierLabelClear.appendChar(32);

        return this;
    }

    /** Deallocates the object's memory. */
    method void dispose() {
        do paddle.dispose();
        do ball.dispose();
        do bricks.dispose();
        do random.dispose();
        do modifier.dispose();
        // --------------- Bugfix abc935kf ---------------
        do twoSpaces.dispose();
        // -----------------------------------------------
        do modifierLabelClear.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Starts the game, and handles input from the user that
     * controls the paddle's movement direction.
     */
    method void run() {
        var char key;

        while ((~exit) & ~(score = (numXBricks * numYBricks))) {
            // waits for a key to be pressed
            while ((key = 0) & (~exit)) {
                let key = Keyboard.keyPressed();
                do paddle.move();
                do moveBall();
                do moveModifier();
                do Sys.wait(10); // DEBUG: original was 30
            }

            if (switchKeys) {
                // <- A, a => move to the right (because switchKeys modifier would be toggled)
                if ((key = 130) | (key = 65) | (key = 97)) { do paddle.setDirection(2); }
                else {
                    // Same logic, and ->, D, d => moves to the left
                    if ((key = 132) | (key = 68) | (key = 100)) { do paddle.setDirection(1); }
                    else {
                        if ((key = 131) | (key = 133)) { do paddle.setDirection(0); }
                        else {
                            if (key = 140) {
                                let exit = true;
                                let isKeyEsc = true;
                            }
                        }
                    }
                }
            } else {
                // <- A, a => move to the left
                if ((key = 130) | (key = 65) | (key = 97)) { do paddle.setDirection(1); }
                else {
                    // ->, D, d => move to the right
                    if ((key = 132) | (key = 68) | (key = 100)) { do paddle.setDirection(2); }
                    else {
                        if ((key = 131) | (key = 133)) { do paddle.setDirection(0); }
                        else {
                            if (key = 140) {
                                let exit = true;
                                let isKeyEsc = true;
                            }
                        }
                    }
                }
            }

            // Waits for the key to be released.
            while ((~(key = 0)) & (~exit) & (~(score = (numXBricks * numYBricks)))) {
                let key = Keyboard.keyPressed();
                do paddle.move();
                do moveBall();
                do moveModifier();
                do Sys.wait(50);
            }
        }

        if (exit) {
            do ball.hide();
            if (isKeyEsc) {
                do Screen.setColor(true);
                do Screen.drawRectangle(0, 0, 511, 255);
                do Sys.halt();
            } else {
                do Output.moveCursor(11,27);
                do Output.printString("Game Over!");
                do Output.moveCursor(13,25);
                do Output.printString("Final Score: ");
                do Output.moveCursor(13,38);
                do Output.printInt(score);
                do Sys.wait(2000);
            }
        }

        if ( score = (numXBricks * numYBricks) ) {
            do Output.moveCursor(11,25);
            do Output.printString("Congratulations!");
            do Output.moveCursor(13,29);
            do Output.printString("You win!");
            do Output.moveCursor(15,25);
            do Output.printString("Final Score: ");
            do Output.moveCursor(15,38);
            do Output.printInt(score);
            do Sys.wait(500);
        }
        return;
    }

    /** Handles ball movement, including bouncing.
      * If the ball bounces off a wall, calculate its new destination.
      * End the game if the ball misses the paddle.
      */
    method void moveBall() {
        var int face; // collision face, left = 0 | right = 1 | top = 2 | bottom = 3
        var Array pos;
        var int x, y;
        var int i, j;
        var Array rowBricks;
        var Brick brick;

        // ------------------ Bugfix id ejritjeritoi ------------
        var boolean bouncedThisFrame; // awaits 1 frame if a ball is touching more than 2 bricks to avoid twicing or multiplying the speed bbecause of the simultaneous collision
        // ------------------------------------------------------

        do ball.hide();
        let wall = 0; // DONT DELETE THIS

        let pos = ball.move();

        let x = pos[0];
        let y = pos[1];

        let bouncedThisFrame = false; // bugfix id ejritjeritoi



        // first check wall collisions AND clamp position
        if (~(x > leftWall)) { // avoid ball from clipping with left wall
            let wall = 1;
            let x = leftWall;
            do ball.setX(x);
        }
        if (~(x < rightWall)) { // avoid ball from clipping with right wall
            let wall = 2;
            let x = rightWall;
            do ball.setX(x);
        }
        if (~(y > topWall)) { // avoid ball from clipping with top wall
            let wall = 3;
            let y = topWall;
            do ball.setY(y);
        }
        if (~(y < bottomWall)) { // avoid ball from clipping with bottom 
            let wall = 4;
            let y = bottomWall;
            do ball.setY(y);
        }

        // check paddle collision right away
        if (wall > 0) {
            if (wall = 4) {
                let exit = ((paddle.getLeft() > ball.getRight()) | (paddle.getRight() < ball.getLeft()));
                if (exit) { do ball.hide(); }
            }
            do ball.bounce(wall);
            let lastWall = wall;
        }

        // iterate through all bricks
        let i = 0;
        while ( i < numYBricks ) {
            let rowBricks = bricks[i];
            let j = 0;
            while ( j < numXBricks ) {
                let brick = rowBricks[j];

                // Only check active bricks
                if (~(brick.broken())) {
                    let face = brick.listen(ball.getLeft(), ball.getRight(), ball.getTop(), ball.getBottom(), seed);
                    do brick.show(); // draw the brick again in case of offset with the ball
                    if (face > 0) {
                        // break brick only if it hasn't been pierced and ball is moving upwards (dy < 0 means upwards)
                        if ((piercingHits < 2) & (ball.getDY() < 0)) {
                            do brick.breakBrick();
                            let score = score + 1;
                        }

                        if ((~piercing) | (piercingHits > 0)) {

                            // ----- bugfix ejritjeritoi ----
                            if (~bouncedThisFrame) {
                                do ball.bounce(face);
                                let bouncedThisFrame = true;
                            }
                            // ------------

                            if ((face = 1) | (face = 2)) {
                                do ball.forceDYDown();
                            }

                            if (piercing) {
                                do modifier.deactivate(); // (Bugfix o646i349o6h) deactivate piercing modifier outside of timer
                                do revertModifier();
                            }
                        } else {
                            let piercingHits = piercingHits + 1;
                        }
                        let wall = face;
                        let lastWall = face;
                        /* what the hell is this?
                        if ((score = 5) | (score = 10)) {
                            do ball.increaseSpeed(1);
                        }
                        */
                        do Output.moveCursor(0, 7);
                        do Output.printInt(score);
                        do Output.moveCursor(0,62);
                        // do Output.printString("  ");
                        // --------------- Bugfix abc935kf ---------------
                        do Output.printString(twoSpaces);
                        // ----------------------------------------

                        do Output.moveCursor(0,62);
                        do Output.printInt((numXBricks * numYBricks) - score);

                        let seed = ((score * 3) + (paddle.getLeft() * 5) + (ball.getLeft() * 11) + (ball.getTop() * 17) + (paddle.getRight() * 7));
                        let generateModifier = random.range(seed, 1, 2); // 1/2 of prob to generate a modifier DEBUG
                        
                        /* Bugfix id kgh54o0h5: ONLY ONE MODIFIER AT THE TIME
                        if (generateModifier = 3) {
                            if (modifier.isActive()) {
                                do revertModifier();
                            }
                            do modifier.dispose();
                            let modifier = Modifier.new(seed, ball.getLeft(), ball.getBottom());
                        }
                        */
                        // FIXED:
                        if (generateModifier = 2) { // if probability >= 50%
                            if (~modifier.isActive() & ~modifier.isOnScreen()) {
                                do modifier.dispose();
                                let modifier = Modifier.new(seed, ball.getLeft(), ball.getBottom());
                            }
                        }

                    }
                }
                let j = j + 1;
            }
            let i = i + 1;
        }

        do ball.show();
        return;
    }

    method void applyModifier() {
        var int t;
        let t = modifier.getType();
        if (t = 1) { do paddle.setWidth(paddle.getWidth() / 2); }
        if (t = 2) { do ball.increaseSpeed(2); }
        if (t = 3) { let switchKeys = true; }
        if (t = 4) { do paddle.setWidth(paddle.getWidth() * 2); }
        if (t = 5) { do ball.increaseSpeed(-2); }
        if (t = 6) { let piercing = true; let piercingHits = 0; }
        do drawModifierLabel();
        return;
    }

    method void revertModifier() {
        var int t;
        let t = modifier.getType();
        if (t = 1) { do paddle.setWidth(paddle.getWidth() * 2); }
        if (t = 2) { do ball.increaseSpeed(-2); }
        if (t = 3) { let switchKeys = false; }
        if (t = 4) { do paddle.setWidth(paddle.getWidth() / 2); }
        if (t = 5) { do ball.increaseSpeed(2); }
        if (t = 6) { let piercing = false; let piercingHits = 0; }
        do clearModifierLabel();
        return;
    }

    method void moveModifier(){
        var boolean onScreen;
        let onScreen = modifier.isOnScreen();
        if(onScreen){
            do modifier.hide();
            
            if((modifier.getY() < (255 -  modifier.getSize() - 1))){
                do modifier.setY(modifier.getY() + 2);
                do modifier.draw();
                if((paddle.getLeft() < (modifier.getX() + modifier.getSize())) & (paddle.getRight() > modifier.getX()) & (((255 - paddleHeight -1) < (modifier.getY() + modifier.getSize())) | ((255 - paddleHeight) = (modifier.getY() + modifier.getSize())))){
                    do modifier.activate();
                    do modifier.hide();
                    do paddle.show();
                    do applyModifier();
                }
            }
            else {
                do modifier.setOnScreen(false);
                do modifier.hide();
            }
        }

        if (modifier.isActive()) {
            if (~(modifier.getType() = 6)) { // (Bugfix o646i349o6h) timer bypasses percing modifier since doesn't depend on time but rather 2 hits on bricks
                do modifier.tickTimer();
                if (modifier.getTimer() = 0) {
                    do modifier.deactivate();
                    do revertModifier();
                }
            }
        }
        return;
    }

    /** Prints the active modifier label at row 0, col 14. */
    method void drawModifierLabel() {
        var int t;
        let t = modifier.getType();
        do Output.moveCursor(0, 14);
        do Output.printString(modifierLabelClear);
        do Output.moveCursor(0, 14);
        if (t = 1) { do Output.printString("(-) SMALL");    }
        if (t = 2) { do Output.printString("(-) QUICK");    }
        if (t = 3) { do Output.printString("(-) INVERTED"); }
        if (t = 4) { do Output.printString("(+) BIG");      }
        if (t = 5) { do Output.printString("(+) SLOW");     }
        if (t = 6) { do Output.printString("(+) PIERCING"); }
        return;
    }

    /** Clears the modifier label field. */
    method void clearModifierLabel() {
        do Output.moveCursor(0, 14);
        do Output.printString(modifierLabelClear);
        return;
    }

}
